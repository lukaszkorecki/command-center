#!/usr/bin/env bb
;; Alfred replacement, but for terminal
;; runs as `nav` (for now!)

(require '[babashka.fs :as fs]
         '[clojure.string :as str]
         '[clojure.java.browse :as browse]
         '[clojure.tools.logging :as log]
         '[babashka.process :as p]
         '[cheshire.core :as json]
         '[babashka.cli :as cli])

(defn ^:private fzf [candidates & args]
  (-> (apply p/shell {:in (str/join "\n" candidates) :out :string :continue true}
             "fzf" args)
      :out
      str/trim
      not-empty))

(def ^:private url-history (fs/expand-home "~/.config/nav/url-history"))
(def ^:private app-history (fs/expand-home "~/.config/nav/app-history"))
(def ^:private repo-history (fs/expand-home "~/.config/nav/repo-history"))

;; initialize these files
(mapv fs/touch [url-history app-history repo-history])

(defn ^:private read-url-history []
  (when (fs/exists? url-history)
    (fs/read-all-lines url-history)))

(defn ^:private save-url! [url]
  (fs/create-dirs (fs/parent url-history))
  (fs/write-lines url-history
                  (distinct (cons url (read-url-history)))))

;; NOTE:
;; dump chrome bookmarks:
;; find . -name Bookmarks and then:
;; jq -r  '.roots[].children[].url' Snapshots/152.0.7977.83/Default/Bookmarks >> ~/.config/nav/url-history
;; firefox - read places.sqlite after copying with following query
;; select * from moz_places p join moz_bookmarks b on b.id = p.fk
(defn browse-url [{:keys [url]}]
  (if-let [url (or (some-> url str/trim not-empty)
                   (fzf (read-url-history)
                        "--header" "Select URL"
                        "--history" url-history))]
    (let [url (if (str/includes? url "://")
                url
                (str "https://" url))]
      (log/infof "opening %s" url)
      (save-url! url)
      (browse/browse-url url))
    (log/warn "empty selection!")))

(defn open-app [{:keys [args]}]
  (if-let [app (fzf (->> ["/Applications" "/System/Applications"]
                         (mapcat #(fs/list-dir % "*.app"))
                         (map str)
                         sort)
                    "--delimiter" "/" "--with-nth" "-1"
                    "--header" "Select application"
                    "--history" app-history
                    "--query" (first args))]
    (do
      (log/infof "opening %s" app)
      (p/shell "open" app))
    (log/warn "empty selection!")))

(defn google-search [_]
  ;; XXX: for whatever reason rest-args are not passed correctly unless
  ;;      quoted, so we ignore what bb.cli gives us and use raw args processing
  (let [query (str/join " " (rest *command-line-args*))]
    (if (str/blank? query)
      (log/errorf "invalid query: '%s'" query)
      (browse/browse-url (str "https://www.google.com/search?q="
                              (java.net.URLEncoder/encode query "UTF-8"))))))

(def ^:private ghostty-new-tab-script
  "on run argv
     tell application \"Ghostty\"
       set cfg to new surface configuration
       set initial working directory of cfg to item 1 of argv
       if (count windows) > 0 then
         new tab in front window with configuration cfg
       else
         new window with configuration cfg
       end if
       activate
     end tell
   end run")

(defn ^:private find-repo->select [{:keys [hint root]}]
  (let [candidates (->> (fs/glob (fs/expand-home root) "**/.git" {:hidden true :max-depth 4})
                        (mapv fs/parent)
                        (mapv fs/absolutize)
                        (mapv str))
        selection (fzf candidates
                       "--delimiter" "/" "--with-nth" "-1"
                       "--header" "Select repo"
                       "--preview" "cd {} && git status"
                       "--history" repo-history
                       "--query" hint)]

    selection))

(defn repo [{:keys [hint root gh emacs term]
             :or {root "."
                  term true}
             :as _args}]
  (when (= (fs/expand-home "~") (fs/expand-home root))
    (log/error "searching from your home dir is not allowed, this is a bad idea")
    (System/exit 1))

  (if-let [selection (not-empty (find-repo->select {:hint hint :root (fs/expand-home root)}))]
    (do
      (log/infof "navigating to %s" selection)
      (cond
        gh (p/shell {:dir selection} "gh" "browse")
        emacs (p/exec "emacsclient" "--no-wait" selection)
        term (p/exec "osascript" "-e" ghostty-new-tab-script selection)
        :else (do
                (log/warn "no action specified")
                (println selection))))
    (log/warn "empty selection!")))

(defn emoji-lookup [{:keys [action mode]}]
  (let [emoji-db-remote "https://raw.githubusercontent.com/muan/unicode-emoji-json/main/data-by-emoji.json"
        emoji-db-cache (fs/expand-home "~/.config/nav/emoji.json")]

    (when-not (fs/exists? emoji-db-cache)
      (log/infof "saving emoji db to '%s'" emoji-db-cache)
      (fs/create-dirs (fs/parent emoji-db-cache))
      (spit (str emoji-db-cache) (slurp emoji-db-remote)))

    (let [candidates (->> (json/parse-string (slurp (str emoji-db-cache)))
                          (map (fn [[em data]]
                                 (str em "\t" (get data "slug"))))
                          (str/join "\n"))
          selection (-> (p/shell {:in candidates :out :string :continue true}
                                 "fzf" "--delimiter" "\t"
                                 "--with-nth" "{1}\t{2}"
                                 "--nth" "2"
                                 "--accept-nth" (if (= mode "slug") "2" "1"))
                        :out
                        str/trim
                        not-empty)]

      (log/debugf "%s -> %s -> %s" action mode selection)
      (if selection
        (case action
          "copy" (p/shell {:in selection} "pbcopy")
          "print" (println selection))
        (log/warn "empty selection!")))))

;; cmd dispatch (with aliases)

(def cmds
  [{:cmds ["browse"]
    :cmd-aliases ["b"]
    :doc "Open URL, or pick one from history"
    :args->opts [:url]
    :spec {:url {:desc "URL to open"}}
    :exec-fn browse-url}

   {:cmds ["app"]
    :cmd-aliases ["a"]
    :doc "Select an app and open it"
    :fn open-app}

   {:cmds ["search"]
    :cmd-aliases ["s" "g"]
    :doc "Google search"
    :args->opts [:query]
    :spec {:query {:desc "Search terms" :required true}}
    :fn google-search}

   {:cmds ["repo"]
    :cmd-aliases ["r"]
    :doc "Select a repo and open it"
    :args->opts [:hint]
    :spec {:root {:desc "Root dir to search in"
                  :required true
                  :validate fs/directory?}
           :gh {:desc "Open in GH?" :coerce :boolean :required true}
           :emacs {:desc "Open in emacs" :coerce :boolean :required true}
           :term {:desc "Open in ghostty" :coerce :boolean :required true}}
    :exec-fn repo}

   {:cmds ["repo-in-term"]
    :doc "Shortcut: select a repo and open it in a new term"
    :exec-fn (fn [_]
               (repo {:root "." :term true}))}

   {:cmds ["repo-in-gh"]
    :doc "Shortcut: Select a repo and open it in GH"
    :exec-fn (fn [_]
               (repo {:root "." :gh true}))}

   {:cmds ["emoji"]
    :doc "Lookup an emoji and print or copy its character or slug"
    :spec {:action {:desc "Action to take: print or copy"
                    :default "copy"
                    :validate #{"copy" "print"}}

           :mode {:desc "Mode to print - slug or actual emoji"
                  :default "raw"
                  :validate #{"slug" "raw"}}}
    :exec-fn emoji-lookup}

   {:cmds ["emoji-copy"]
    :doc "Lookup an emoji and copy it"
    :exec-fn (fn [_]
               (emoji-lookup {:action "copy" :mode "raw"}))}

   {:cmds ["emoji-copy-slug"]
    :doc "Lookup an emoji and copy its slug"
    :exec-fn (fn [_]
               (emoji-lookup {:action "copy" :mode "slug"}))}])

(defn -main [args]
  (cli/dispatch cmds args {:prog "nav" :help true}))

(-main *command-line-args*)
