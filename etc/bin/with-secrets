#!/usr/bin/env bash
# Runs a command with the global fnox secrets, including on-demand
# (env = "exec") ones that shells and Emacs never get.
#
#   with-secrets lein deploy clojars
#   with-secrets gh pr create
set -euo pipefail

if [[ $# -eq 0 ]]; then
  echo "usage: with-secrets <command> [args...]" >&2
  exit 64
fi

# Explicit config: skips the cwd's fnox.toml, the global one still loads.
exec fnox -c "${FNOX_CONFIG_DIR:-$HOME/.config/fnox}/config.toml" exec -- "$@"
